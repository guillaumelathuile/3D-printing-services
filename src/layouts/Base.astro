---
import { site } from '../config';
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`${base}/`}>{site.name}</a>
      <a href={`${base}/#contact`}>Contact</a>
    </header>
    <slot />
    <footer>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href={`${base}/mentions-legales`}>Mentions légales</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #101820;
    --paper: #f3f4f1;
    --accent: #2540d9;
    --muted: #596270;
    --line: #d5d9de;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 400 1.0625rem/1.6 'IBM Plex Sans', system-ui, sans-serif;
  }
  h1, h2, h3, .brand {
    font-family: 'Bricolage Grotesque', 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.1;
    margin: 0;
  }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .wrap { max-width: 68rem; margin: 0 auto; padding: 0 1.5rem; }
  .top {
    max-width: 68rem; margin: 0 auto; padding: 1.5rem;
    display: flex; justify-content: space-between; align-items: center;
  }
  .top a { text-decoration: none; font-weight: 500; }
  .brand { font-size: 1.25rem; font-weight: 700; color: var(--ink); }
  .hero {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: center;
    padding-top: 3rem; padding-bottom: 5rem;
  }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 700; letter-spacing: -0.02em; }
  .hero p { max-width: 36rem; color: var(--muted); font-size: 1.2rem; margin: 1.25rem 0 0; }
  .hero .note { font-size: 1rem; margin-top: 1rem; }
  .btn {
    display: inline-block; margin-top: 2rem; padding: 0.9rem 1.6rem;
    background: var(--accent); color: #fff; text-decoration: none;
    font-weight: 500; border-radius: 6px;
  }
  .btn:hover { background: var(--ink); }
  .layers {
    aspect-ratio: 1 / 1; border-radius: 8px;
    background:
      linear-gradient(var(--accent), var(--accent)) top / 100% 14% no-repeat,
      repeating-linear-gradient(to bottom, var(--ink) 0 3px, transparent 3px 11px);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
            mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(1.7rem, 3.5vw, 2.3rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 2rem; }
  h3 { font-size: 1.2rem; font-weight: 600; }
  .rows > div {
    display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;
    padding: 1.25rem 0; border-bottom: 1px solid var(--line);
  }
  .rows > div:first-child { padding-top: 0; }
  .rows p, .rows dd { margin: 0; color: var(--muted); max-width: 40rem; }
  .rows dt { margin: 0; }
  .aside { margin-top: 1.5rem; max-width: 40rem; color: var(--muted); }
  ol.steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  ol.steps li { counter-increment: s; border-top: 3px solid var(--ink); padding-top: 1rem; }
  ol.steps li::before { content: counter(s); font: 700 1.4rem 'Bricolage Grotesque', sans-serif; color: var(--accent); display: block; margin-bottom: 0.4rem; }
  .empty { border: 1px dashed var(--muted); border-radius: 8px; padding: 2rem; color: var(--muted); max-width: 40rem; }
  .prose { max-width: 42rem; }
  .prose h2 { margin-top: 2.5rem; font-size: 1.4rem; }
  footer {
    max-width: 68rem; margin: 0 auto; padding: 2rem 1.5rem 3rem;
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    border-top: 1px solid var(--line); color: var(--muted); font-size: 0.95rem;
  }
  footer a { color: var(--muted); }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-bottom: 3rem; }
    .layers { aspect-ratio: 3 / 1; }
    .rows > div { grid-template-columns: 1fr; gap: 0.4rem; }
    ol.steps { grid-template-columns: 1fr 1fr; }
  }
</style>
